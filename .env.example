# Copy to .env.local for local work. Never commit .env.local.

# Attribution tag sent on every speedrun API call. Also set this in Vercel.
SPEEDRUN_SOURCE_TAG=role-decoder-edison
SPEEDRUN_API_BASE=https://speedrun-talent-network.com/api/v1

# Optional and local only. Used by scripts/extract-responsibilities.ts.
# The deployed site makes no LLM calls, so do not add this to Vercel.
ANTHROPIC_API_KEY=
